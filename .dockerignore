# Build context is the repo root for the backend image (it needs infrastructure/migrations).
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/node_modules/
frontend/dist/
.storage/
backups/
.git/
# Secrets never enter an image, from any directory (NFR-ME-009, SEC-001).
**/.env
**/.env.*
!**/.env.example
