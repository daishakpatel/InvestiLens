# Copy to .env and fill in. Never commit .env.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_DB=investilens
POSTGRES_USER=investilens
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://investilens:change-me@localhost:5432/investilens
REDIS_URL=redis://localhost:6379/0
# Migration tests create/drop a throwaway DB on this server (defaults to DATABASE_URL's server).
# TEST_DATABASE_URL=postgresql+psycopg://investilens:change-me@localhost:5432/investilens

# --- Providers: mock (frozen fixtures, offline) or live (real APIs). CI uses mock. ---
PROVIDER_MODE=mock

# --- SEC EDGAR (LGL-002: descriptive User-Agent with contact email is mandatory) ---
SEC_USER_AGENT="Assay Desk you@example.com"
# Backfill windows per form (ING-002, FR-EX-010); defaults shown.
# BACKFILL_10K_YEARS=5
# BACKFILL_10Q_QUARTERS=12
# BACKFILL_8K_MONTHS=24
# BACKFILL_PROXY_YEARS=3
# BACKFILL_NT_YEARS=3

# --- Market data (ADR-0007, ADR-0008) ---
# Real prices: set the key and PRICE_PROVIDER=tiingo (ADR-0035), then run
# `cd backend && uv run python ../scripts/ingest_prices.py NVDA AAPL ...`. Unset = sample prices.
TIINGO_API_KEY=
# PRICE_PROVIDER=tiingo
# Local use without the scheduler: refresh prices older than 12 hours each time the API starts.
# REFRESH_PRICES_ON_STARTUP=true
# Real news: free key from https://finnhub.io/register, set NEWS_PROVIDER=finnhub (ADR-0038), then
# run `cd backend && uv run python ../scripts/ingest_news.py NVDA AAPL ...`. Unset = sample news.
FINNHUB_API_KEY=
# NEWS_PROVIDER=finnhub

# --- AI (ADR-0032, ADR-0010) ---
# Gemini key from https://aistudio.google.com/api-keys. LLM_PROVIDER=gemini turns the real model on
# by itself; leave it unset to follow PROVIDER_MODE (mock = canned answers, no key needed).
GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini turns on real embeddings with the same key (ADR-0033); then run
# `cd backend && uv run python ../scripts/embed_chunks.py` once. Unset = follow PROVIDER_MODE
# (live uses Voyage and needs VOYAGE_API_KEY).
# EMBEDDING_PROVIDER=gemini
# EX-99 press releases and DEF 14A proxies are embedded too; a proxy is ~1-2k chunks. Set false
# to keep them keyword-search only (FR-EX-013).
# EMBED_EXHIBITS=true
VOYAGE_API_KEY=

# --- Auth (ADR-0005) — generate with: openssl rand -hex 32 ---
JWT_SECRET=
# Local http dev only: Safari drops a Secure refresh cookie on http://localhost, so every reload
# signs you out. Leave unset (true) anywhere served over https.
# REFRESH_COOKIE_SECURE=false

# --- Object storage (ADR-0012) — MinIO locally; set these when OBJECT_STORAGE_BACKEND=s3 ---
MINIO_ROOT_USER=investilens
MINIO_ROOT_PASSWORD=change-me
# OBJECT_STORAGE_BACKEND=filesystem   # or "s3" (MinIO/AWS)

# --- Background jobs & cache (Phase 5d, ADR-0024) ---
# Celery broker/result backend (Redis DBs 1/2 by default). The compose stack sets these per-service.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Off locally so the API behaves like Phase 4a; the compose stack turns them on.
# BACKGROUND_JOBS_ENABLED=false
# CACHE_ENABLED=false
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_BACKEND=memory          # or "redis"

# --- Notifications / alert dispatch (ADR-0025) ---
# NOTIFICATION_EMAIL_BACKEND=log     # or "smtp" (then set SMTP_* below)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Demo mode (scope #12) — restrictive AI quota + pre-generated reports ---
# DEMO_MODE=false
# DEFAULT_AI_BUDGET_MONTH_USD=5.00

# --- Observability (ADR-0021) — optional OTLP collector; console exporter if unset ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# GRAFANA_ADMIN_PASSWORD=admin
