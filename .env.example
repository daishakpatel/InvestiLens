# Copy to .env and fill in. Never commit .env.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_DB=investilens
POSTGRES_USER=investilens
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://investilens:change-me@localhost:5432/investilens
REDIS_URL=redis://localhost:6379/0
# Migration tests create/drop a throwaway DB on this server (defaults to DATABASE_URL's server).
# TEST_DATABASE_URL=postgresql+psycopg://investilens:change-me@localhost:5432/investilens

# --- Providers: mock (frozen fixtures, offline) or live (real APIs). CI uses mock. ---
PROVIDER_MODE=mock

# --- SEC EDGAR (LGL-002: descriptive User-Agent with contact email is mandatory) ---
SEC_USER_AGENT="InvestiLens you@example.com"

# --- Market data (ADR-0007, ADR-0008) ---
TIINGO_API_KEY=
FINNHUB_API_KEY=

# --- AI (ADR-0009, ADR-0010) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Auth (ADR-0005) — generate with: openssl rand -hex 32 ---
JWT_SECRET=

# --- Object storage (ADR-0012) — MinIO locally; set these when OBJECT_STORAGE_BACKEND=s3 ---
MINIO_ROOT_USER=investilens
MINIO_ROOT_PASSWORD=change-me
# OBJECT_STORAGE_BACKEND=filesystem   # or "s3" (MinIO/AWS)

# --- Background jobs & cache (Phase 5d, ADR-0024) ---
# Celery broker/result backend (Redis DBs 1/2 by default). The compose stack sets these per-service.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Off locally so the API behaves like Phase 4a; the compose stack turns them on.
# BACKGROUND_JOBS_ENABLED=false
# CACHE_ENABLED=false
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_BACKEND=memory          # or "redis"

# --- Notifications / alert dispatch (ADR-0025) ---
# NOTIFICATION_EMAIL_BACKEND=log     # or "smtp" (then set SMTP_* below)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Demo mode (scope #12) — restrictive AI quota + pre-generated reports ---
# DEMO_MODE=false
# DEFAULT_AI_BUDGET_MONTH_USD=5.00

# --- Observability (ADR-0021) — optional OTLP collector; console exporter if unset ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# GRAFANA_ADMIN_PASSWORD=admin
